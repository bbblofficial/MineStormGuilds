# ==========================================================
# MineStormGuilds - Configuration  |  Created by Muvixo
# ==========================================================
settings:
  name-min: 3
  name-max: 16
  max-ranks: 10
  # 0 = unlimited
  max-members: 50
  invite-expire-seconds: 60
  suppress-public-join-quit: true
  # Default color code of newly created guilds (0-9, a-f)
  default-color: a

tab:
  enabled: true
  # 16 is the limit for Minecraft 1.8-1.12 clients. Raise it (max 64) on 1.13+ only networks.
  max-prefix-length: 16
  formats:
    NAME: "%guild_color%[%guild_name%] &f"
    RANK: "%guild_color%[%guild_rank%] &f"
    NAME_RANK: "%guild_color%[%guild_name%|%guild_rank%] &f"
    NONE: ""

formats:
  member-join: "&2Guild > &a%player% &ejoined the Server!"
  member-quit: "&2Guild > &a%player% &eleft the Server!"
  guild-chat: "&2Guild > &f%player% &b[%rank%]&f: %message%"

placeholders:
  no-guild: ""

# Cross-server guild chat through the BungeeCord / Velocity plugin.
# Requires a restart after changing.
bridge:
  enabled: false

# ============================================================
#  MySQL — the plugin creates the database and tables itself.
#  You only fill in the four values below.
#  Leave type: sqlite if you don't want a shared MySQL.
# ============================================================
database:
  type: mysql

  # --- the only things you need to set ---
  host: "127.0.0.1"
  database: "minestormguilds"
  username: "root"
  password: ""

  # --- optional overrides ---
  port: 3306
  useSSL: false
  serverTimezone: "UTC"
  # how many server-threads can hold a connection at once
  poolSize: 10

  # --- SQLite settings (only used when type: sqlite) ---
  file: "guilds.db"

  # How often each server re-reads the shared DB (seconds).
  # 0 = disabled (changes only show up on restart).
  refresh-interval-seconds: 5

# ============================================================
#  Auto-merge: after a plugin update, keys that are missing from your files are added
#  automatically. Your values and comments are never changed or removed
#  (a .bak copy is written first).
#    config:   config.yml          messages: messages.yml
#    database: create/upgrade missing tables, columns and indexes
# ============================================================
auto-merge:
  config: true
  messages: true
  database: true
