<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.minestorm.guilds</groupId>
    <artifactId>minestormguilds-parent</artifactId>
    <version>1.0.1</version>
  </parent>
  <artifactId>minestormguilds-velocity</artifactId>
  <name>MineStormGuilds-Velocity</name>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <velocity.version>3.4.0-SNAPSHOT</velocity.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.velocitypowered</groupId>
      <artifactId>velocity-api</artifactId>
      <version>${velocity.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>MineStormGuilds-Velocity-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- JDK 23+ no longer runs annotation processors found on the classpath by default,
               so the @Plugin processor (generates velocity-plugin.json) is declared explicitly. -->
          <annotationProcessorPaths>
            <path>
              <groupId>com.velocitypowered</groupId>
              <artifactId>velocity-api</artifactId>
              <version>${velocity.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
